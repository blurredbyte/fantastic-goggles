# This Dockerfile is a SECURE alternative to the vulnerable one.

# 1. Use a specific, minimal, and trusted base image.
# Using a specific tag like '3.8.13-slim-buster' ensures reproducible builds.
# The 'slim' variant has a smaller attack surface than the full OS image.
FROM python:3.8.13-slim-buster

# Set a working directory
WORKDIR /app

# Create a non-root user to run the application.
# This is a critical security best practice.
# -S creates a system user, -G adds them to a group.
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy the requirements file first to leverage Docker's build cache.
# The layer will only be rebuilt if the requirements file changes.
COPY requirements.txt .

# 2. Install packages using a requirements file with pinned versions.
# This ensures that you are using known, vetted versions of your dependencies.
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the application code
COPY . .

# Change ownership of the app directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to the non-root user.
# Any subsequent commands will be run as this user.
USER appuser

# 3. Do NOT hardcode secrets.
# Secrets should be injected at runtime using a secrets management tool
# (e.g., Kubernetes Secrets, Docker Secrets, HashiCorp Vault).
# The application (app.py) should be modified to read secrets from
# environment variables or mounted files, which are provided at runtime.

# Expose the port the application runs on
EXPOSE 5000

# Run the application
CMD [ "python", "app.py" ]
